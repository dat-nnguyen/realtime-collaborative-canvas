# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# WebSocket & Connection Limits
MAX_BUFFERED_AMOUNT_BYTES=65536     # 64 KB slow client backpressure limit
PING_INTERVAL_MS=30000              # 30s heartbeat
AWARENESS_THROTTLE_MS=33            # ~30 Hz broadcast limit for cursor moves

# Persistence & Storage
DATABASE_URL=postgres://postgres:postgres@localhost:5432/canvas_db
SNAPSHOT_DEBOUNCE_MS=2000           # 2s quiet period before snapshotting
SNAPSHOT_MAX_WAIT_MS=30000          # 30s max wait during constant edits
ROOM_IDLE_TIMEOUT_MS=60000          # 60s without connections before in-memory eviction

# Redis Pub/Sub Cluster
REDIS_URL=redis://localhost:6379
INSTANCE_ID=node-1
